{
  "name": "nivraa-pricing-api",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready lightweight pricing API for NivrāaCare",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "check": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.2.1",
    "@fastify/swagger": "9.4.2",
    "@fastify/swagger-ui": "5.2.2",
    "decimal.js": "10.5.0",
    "dotenv": "16.5.0",
    "fastify": "5.3.3",
    "pino": "9.7.0",
    "zod": "3.25.51"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  }
}
